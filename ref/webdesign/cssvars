/* Design tokens (ref/webdesign/design.md). Same values as the :root of src/viewer/style.css; the
   map (src/render/svg.ts) uses the colours and the system stack with literal values. */
:root {
  /* Colors */
  --color-canvas-mist: #f6f8f7;
  --color-ink-black: #000000;
  --color-carbon: #231f20;
  --color-steel-gray: #e5e5e5;
  --color-band: #d1d3d4;
  --color-graphite: #b2b2b2;
  --color-muted: #6d6e71;
  --color-amber: #f0a000;

  /* Typography — families */
  --font: Jura, Inter, "Helvetica Neue", Arial, "Noto Sans", "DejaVu Sans", sans-serif; /* viewer */
  --font-map: Inter, "Helvetica Neue", Arial, "Noto Sans", "DejaVu Sans", sans-serif;   /* SVG */

  /* Typography — viewer scale, weight 300, uppercase, letter-spacing 0.02em */
  --text-title: 32px;
  --leading-title: 1.11;
  --text-band: 19px;
  --leading-band: 1.15;
  --text-emphasis: 15px;
  --text-input: 14px;
  --text-body: 13px;
  --leading-body: 1.4;
  --text-small: 11px;

  /* Typography — map scale, weight 100 text, 300 numbers and headings */
  --text-map: 13px;
  --text-map-number: 19px;
  --text-map-tag: 10px;

  /* Spacing */
  --spacing-15: 15px;
  --spacing-22: 22px;
  --spacing-33: 33px;

  /* Layout */
  --panel: 300px;
  --breakpoint: 800px; /* not usable in @media; written literally there */

  /* Radius: 0 everywhere, 50% only for the circled section number */
}
